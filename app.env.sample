# Kutt URL Shortener - Environment Variables
# Copy to app.env and customize

# Timezone
TZ=America/New_York

# Domain settings
BASE_DOMAIN_NAME=example.com
BASE_HOST_NAME=kutt.example.com

# Database
DB_CREATE_DATABASE_NAME=kutt
DB_USER_NAME=kutt
DB_USER_PASS=changeme_db_password

# Application secrets
APP_SECRET_KEY=changeme_secret_key_min_32_chars

# Admin
APP_ADMIN_USER=admin
APP_ORG_NAME=Kutt

# Email (SMTP)
EMAIL_SERVER_HOST=172.17.0.1
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASS=
EMAIL_SERVER_MAIL_FROM=no-reply@example.com
